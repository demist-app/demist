{
  "expo": {
    "name": "Demist",
    "slug": "demist",
    "scheme": "demist",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F0F8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.demist.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Demist listens to your lecture so it can write it down and explain new words as they come up. The sound stays on your device.",
        "NSSpeechRecognitionUsageDescription": "Demist turns your lecture into text on your device, so you can read along and look back later.",
        "NSPhotoLibraryUsageDescription": "Demist does not use your photos. Lectures, notes and words are the only things it saves."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "app.demist.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#EEE9F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Demist listens to your lecture so it can write it down and explain new words as they come up. The sound stays on your device.",
          "speechRecognitionPermission": "Demist turns your lecture into text on your device, so you can read along and look back later."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F3F0F8",
          "dark": {
            "backgroundColor": "#110B1C"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d4fd198-976e-4a53-89a4-55328752d366"
      }
    },
    "owner": "graceful-minds"
  }
}
