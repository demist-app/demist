{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.105.4",
    "expo": "~56.0.24",
    "expo-application": "~56.0.3",
    "expo-constants": "~56.0.27",
    "expo-dev-client": "~56.0.28",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.19",
    "expo-localization": "~56.0.6",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-speech": "~56.0.3",
    "expo-speech-recognition": "56.0.4",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "posthog-react-native": "^4.81.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "sync-shared": "node scripts/sync-shared.mjs",
    "check-shared": "node scripts/sync-shared.mjs --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run check-shared && npm run typecheck && expo export -p ios --output-dir .expo/export-check",
    "build:dev": "eas build -p ios --profile development",
    "build:preview": "eas build -p ios --profile preview",
    "build:ios": "eas build -p ios --profile production",
    "submit:ios": "eas submit -p ios --profile production --latest",
    "postinstall": "patch-package"
  },
  "private": true
}
